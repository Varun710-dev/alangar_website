# Copy to .env (never commit .env). Server-side only.
NODE_ENV=development
PORT=3000
SESSION_SECRET=change_this_to_a_random_string_of_32_or_more_characters
ADMIN_USER_ID=change_this
# First run only: plain value is hashed and stored; then delete it. In production use the _HASH variants (bcrypt).
ADMIN_PASSWORD=change_this
# ADMIN_PASSWORD_HASH=
ADMIN_RECOVERY_PASSWORD=change_this
# ADMIN_RECOVERY_PASSWORD_HASH=
